generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id                String   @id @default(cuid())
  locale            String   @default("pt")
  userStory         String?
  requirement       String
  additionalContext String?
  riskScore         Int
  result            Json
  testCases         Json
  gherkin           Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
